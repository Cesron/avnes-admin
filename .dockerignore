# ----- dependencias y builds -----
node_modules
.next
out
build
.pnp
.pnp.js
.yarn/install-state.gz

# ----- archivos de tipo y build cache -----
*.tsbuildinfo
next-env.d.ts

# ----- entorno y secretos -----
.env
.env.local
.env.*.local
!.env.example

# ----- git / VCS -----
# .git se excluye para no inflar la imagen; .gitignore se mantiene porque
# Tailwind v4 / oxide-scanner lo usa para detectar archivos fuente.
.git
.gitattributes

# ----- logs y temporales -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# ----- documentación y utilidades locales -----
README.md
.agents
.uploads
debug-attendance.ts

# ----- configs de herramientas no necesarias en runtime -----
# postcss.config.mjs y components.json NO se excluyen: el build los necesita.
biome.json
.idea
.vscode

# ----- Docker (evita recursión) -----
Dockerfile
.dockerignore
docker-compose*.yml
